# DeepSeek AI API Key（已有）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 对话模型：deepseek-v4-flash（快、便宜）或 deepseek-v4-pro（更强）
# 注意：旧的 deepseek-chat 已被官方下线
DEEPSEEK_MODEL=deepseek-v4-flash

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=your-jwt-secret-change-in-production

# Stripe 支付配置
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_ID_MONTHLY=price_your_monthly_price_id

# 前端 URL（用于 Stripe 支付回跳）
FRONTEND_URL=http://localhost:5173

# ===== 本地视频上传解析（语音识别）=====
# 模型大小：tiny / base / small / medium / large-v3
# 越大越准也越慢。CPU 环境推荐 base（默认）或 small
WHISPER_MODEL_SIZE=base
# 设备：cpu / cuda（有 NVIDIA 显卡时用 cuda 可快 5-10 倍）
WHISPER_DEVICE=cpu
# 计算精度：cpu 用 int8，cuda 可用 float16
WHISPER_COMPUTE_TYPE=int8
# 强制识别语言（留空表示自动检测），例如 zh / en
WHISPER_LANGUAGE=
# 首次运行会自动下载模型；国内网络可用镜像加速
# HF_ENDPOINT=https://hf-mirror.com

# ===== 解析引擎自动升级 =====
# 后端启动时自动检查并升级 yt-dlp 到最新版（防止平台接口变更导致解析失效）
# 如需关闭（例如离线环境），设为 false
YTDLP_AUTO_UPGRADE=true

# ===== 管理员账号 =====
# 逗号分隔的邮箱，命中的已注册账号即为管理员（不改数据库，改完重启生效）。
# 管理员不受以下限制：每日 AI 总结次数、单用户并发任务数、文件大小、视频时长。
# 注意：管理员只放宽自己的用量，不能查看或管理其他用户的数据。
ADMIN_EMAILS=
# 管理员的上传大小上限（MB）。仍保留有限值，避免误操作把磁盘写满。
ADMIN_MAX_FILE_SIZE_MB=5000
